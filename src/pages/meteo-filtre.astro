---
import "../styles/global.css";
---

<html lang="fr" data-theme="light">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Météo Filtre</title>
    </head>
    <body class="bg-base-200 min-h-screen p-4 md:p-8">
        <main class="container mx-auto max-w-5xl">
            <div class="flex justify-between items-center mb-8">
                <a href="/" class="btn btn-outline btn-primary"
                    >Retour à l'accueil</a
                >
                <a href="/meteo-multifiltres" class="btn btn-primary"
                    >Graphique suivant</a
                >
            </div>

            <div class="card bg-base-100 shadow-xl border border-base-300">
                <div class="card-body">
                    <h1
                        class="card-title text-3xl font-extrabold text-secondary mb-2"
                    >
                        Analyse Météo (Filtre Ville)
                    </h1>
                    <p class="opacity-75 mb-6">
                        Évolution temporelle des températures maximales par
                        ville (Seattle et New York).
                    </p>

                    <div class="flex flex-wrap items-center gap-3 mb-6">
                        <label for="filtre-ville" class="font-bold text-sm"
                            >Filtrer par ville :</label
                        >
                        <select
                            name="filtre-ville"
                            id="filtre-ville"
                            class="select select-bordered select-primary select-sm"
                        >
                            <option value="">Toutes les villes</option>
                            <option value="Seattle">Seattle</option>
                            <option value="New York">New York</option>
                        </select>
                    </div>

                    <div
                        id="graphique-meteo"
                        class="overflow-x-auto w-full flex justify-center bg-white p-4 rounded-box border border-base-200"
                    >
                    </div>
                </div>
            </div>
        </main>

        <script>
            import * as Plot from "@observablehq/plot";
            import meteo from "../assets/weather.json";

            const selectFiltre = document.querySelector(
                "#filtre-ville",
            ) as HTMLSelectElement;

            function renderPlot() {
                const valeurFiltre = selectFiltre.value;
                const div = document.querySelector(
                    "#graphique-meteo",
                ) as HTMLDivElement;

                div.innerHTML = "";

                const plot = Plot.plot({
                    color: {
                        legend: true,
                    },
                    marks: [
                        Plot.dot(meteo, {
                            // Conversion du texte en objet Date pour aérer l'axe X
                            x: (d) => new Date(d.date),
                            y: "temp_max",
                            stroke: "location",
                            filter: (d) =>
                                valeurFiltre === "" ||
                                d.location === valeurFiltre,
                        }),
                    ],
                });

                div.append(plot);
            }

            selectFiltre.addEventListener("change", renderPlot);
            renderPlot();
        </script>
    </body>
</html>
