---
import "../styles/global.css";
---

<html lang="fr" data-theme="light">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Simple Pizza</title>
    </head>
    <body class="bg-base-200 min-h-screen p-4 md:p-8">
        <main class="container mx-auto max-w-5xl">
            <div class="flex justify-between items-center mb-8">
                <a href="/" class="btn btn-outline btn-primary"
                    >Retour à l'accueil</a
                >
                <a href="/pizza-filtre" class="btn btn-primary"
                    >Graphique suivant</a
                >
            </div>

            <div class="card bg-base-100 shadow-xl border border-base-300">
                <div class="card-body">
                    <h1
                        class="card-title text-3xl font-extrabold text-secondary mb-2"
                    >
                        Graphique des Pizzas (Simple)
                    </h1>
                    <p class="opacity-75 mb-6">
                        Aperçu chronologique global des revenus générés par
                        commande selon la catégorie de pizza.
                    </p>

                    <div
                        id="graphique-pizza"
                        class="overflow-x-auto w-full flex justify-center bg-white p-4 rounded-box border border-base-200"
                    >
                    </div>
                </div>
            </div>
        </main>

        <script>
            import * as Plot from "@observablehq/plot";
            import pizzas from "../assets/pizza.json";

            const plot = Plot.plot({
                color: {
                    legend: true,
                },
                marks: [
                    Plot.dot(pizzas, {
                        x: (d) => new Date(d.order_date),
                        y: "revenue",
                        stroke: "category",
                    }),
                ],
            });

            const div = document.querySelector(
                "#graphique-pizza",
            ) as HTMLDivElement;
            div.append(plot);
        </script>
    </body>
</html>
