---

<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <title>Pizza Multi Filtres</title>
    </head>
    <body class="p-8">
        <a href="/" class="text-blue-600 underline mb-4 inline-block"
            >Retour à l'accueil</a
        >
        <h1 class="text-2xl font-bold mb-6">
            Ventes de Pizzas : Filtres Multiples
        </h1>

        <div class="flex flex-wrap gap-6 mb-6">
            <div>
                <label for="category" class="font-bold mr-2">Catégorie :</label>
                <select
                    name="category"
                    id="category"
                    class="border p-1 rounded"
                >
                    <option value="">Toutes</option>
                    <option value="Classic">Classique</option>
                    <option value="Specialty">Spécialité</option>
                    <option value="Vegetarian">Végétarienne</option>
                </select>
            </div>

            <div>
                <label for="day" class="font-bold mr-2">Jour :</label>
                <select name="day" id="day" class="border p-1 rounded">
                    <option value="">Tous</option>
                    <option value="Monday">Lundi</option>
                    <option value="Tuesday">Mardi</option>
                    <option value="Wednesday">Mercredi</option>
                    <option value="Thursday">Jeudi</option>
                    <option value="Friday">Vendredi</option>
                    <option value="Saturday">Samedi</option>
                    <option value="Sunday">Dimanche</option>
                </select>
            </div>
        </div>

        <div id="graphique-pizza"></div>

        <script>
            import * as Plot from "@observablehq/plot";
            import pizzas from "../assets/pizza.json";

            const selectCategory = document.querySelector(
                "#category",
            ) as HTMLSelectElement;
            const selectDay = document.querySelector(
                "#day",
            ) as HTMLSelectElement;

            function renderPlot() {
                const category = selectCategory.value;
                const day = selectDay.value;

                const div = document.querySelector(
                    "#graphique-pizza",
                ) as HTMLDivElement;
                div.innerHTML = "";

                const plot = Plot.plot({
                    marks: [
                        Plot.dot(pizzas, {
                            x: (d) => new Date(d.order_date),
                            y: "revenue",
                            stroke: "category",
                            filter: (d) =>
                                (category === "" || d.category === category) &&
                                (day === "" || d.day_of_week === day),
                        }),
                    ],
                });

                div.append(plot);
            }

            selectCategory.addEventListener("change", renderPlot);
            selectDay.addEventListener("change", renderPlot);

            renderPlot();
        </script>
    </body>
</html>
